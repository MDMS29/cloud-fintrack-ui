# --- Cliente (se compila dentro del bundle, requiere prefijo VITE_) ---
# Dejar VACIA: en dev la resuelve el proxy de Vite y en prod el rewrite de vercel.json.
# Solo llenarla (URL absoluta, sin / final) si se apunta al backend sin proxy => exige CORS.
VITE_API_BASE_URL=

# --- Solo dev, lado Node (vite.config.ts) ---
# Backend al que el proxy de Vite reenvia /api
API_PROXY_TARGET=
